PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cognitive-campus

# JWT
JWT_SECRET=your_super_secret_key_here_minimum_32_chars
JWT_EXPIRES_IN=24h

# Redis (Upstash recommended for cloud, or local Redis)
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Piston — self-hosted code execution engine
# Run: docker run -d --name piston --privileged -p 2000:2000 ghcr.io/engineer-man/piston
CODE_EXECUTION_API_URL=http://localhost:2000/api/v2

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# AI APIs (optional — required for AI Nudge and Dashboard Quote features)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Email (optional — for transactional emails)
RESEND_API_KEY=your_resend_api_key
